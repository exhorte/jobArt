# Copier ce fichier en .env puis adapter. Ne jamais versionner .env.
# --- PostgreSQL (docker compose) ---
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=jobradar
POSTGRES_PORT=54330

# --- Backend ---
# URL SQLAlchemy (driver psycopg v3). Hôte "localhost" en dev local, "db" dans docker compose.
DATABASE_URL=postgresql+psycopg://jobradar:change-me-locally@127.0.0.1:54330/jobradar
# embedded : l'API héberge le planificateur (un seul processus effectif grâce au bail en base)
# off      : l'API n'héberge pas le planificateur (lancer `python -m jobradar.jobs.worker` à part)
SCHEDULER_MODE=embedded
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Identité envoyée aux sites collectés. Vous pouvez y ajouter une adresse de contact si vous le souhaitez.
HTTP_USER_AGENT="JobRadar/0.1 (personal job watcher; respects robots.txt)"
COLLECT_MAX_CONCURRENCY=3
REQUEST_TIMEOUT_SECONDS=20
SOURCE_TIMEOUT_SECONDS=240
MIN_REQUEST_DELAY_SECONDS=1.5

# --- Frontend ---
# URL du backend vue par le serveur Next.js (proxy /api). Dans docker compose : http://backend:8000
BACKEND_URL=http://localhost:8000
